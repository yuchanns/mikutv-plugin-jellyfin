{
  "id": "jellyfin",
  "name": "Jellyfin",
  "description": "Your media, on your terms.",
  "kind": "source",
  "version": "1.0.7",
  "apiVersion": 1,
  "minAppVersion": "0.1.0",
  "license": "Apache-2.0",
  "main": "index.js",
  "artwork": {
    "cover": "cover.png"
  },
  "permissions": {
    "network": []
  },
  "authentication": {
    "methods": [
      "credentials"
    ],
    "serverURL": "required",
    "presentation": {
      "accountSubtitle": "The Free Software Media System",
      "guestTitle": "Jellyfin",
      "guestDescription": "Your media, on your terms.",
      "credentialsTitle": "Sign In to Jellyfin",
      "credentialsDescription": "Enter your server address and account.",
      "serverURLPlaceholder": "http://192.168.1.10:8096",
      "usernamePlaceholder": "Username"
    }
  },
  "presentation": {
    "creatorGroupTitle": "Movies",
    "search": {
      "hint": "Search your Jellyfin library"
    }
  },
  "capabilities": [
    "account.signIn",
    "catalog.browse",
    "catalog.item",
    "catalog.search",
    "catalog.searchSuggest",
    "catalog.library",
    "account.history",
    "account.editHistory",
    "account.favorites",
    "account.editFavoriteFolders",
    "account.videoInteraction",
    "account.videoFavorites",
    "playback.resolve",
    "playback.subtitles",
    "playback.progress"
  ],
  "locales": {
    "zh-Hans": {
      "name": "Jellyfin",
      "description": "自由开源的个人媒体系统",
      "authentication": {
        "accountSubtitle": "自由开源的个人媒体系统",
        "guestTitle": "Jellyfin",
        "guestDescription": "你的个人媒体，由你掌控。",
        "credentialsTitle": "登录 Jellyfin",
        "credentialsDescription": "输入服务器地址与账号。",
        "serverURLPlaceholder": "http://192.168.1.10:8096",
        "usernamePlaceholder": "用户名"
      },
      "presentation": {
        "creatorGroupTitle": "电影",
        "search": {
          "hint": "搜索电影、剧集与单集"
        }
      }
    },
    "ja": {
      "name": "Jellyfin",
      "description": "自由でオープンソースのメディアシステム",
      "authentication": {
        "accountSubtitle": "自由でオープンソースのメディアシステム",
